# Copy to .env.local (secrets) / .env (DATABASE_URL) and fill in.

# --- Database (Step 2 foundation) ---
# Postgres connection string. Works with Neon, Vercel Postgres, or Supabase.
# Neon example: postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/demashop?sslmode=require
# Supabase:     use the "Connection pooling" (port 6543) string for serverless.
DATABASE_URL=

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (quotes / order confirmation) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- Bank details shown on the order confirmation (public) ---
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_BIC=

# --- Product enrichment (Step 3) ---
# ICEcat: primary structured datasheet source (specs, EAN, images).
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_LANG=en
# Apify: fallback manufacturer-site scraping. Put the ROTATED token here only.
APIFY_TOKEN=
APIFY_MANUFACTURER_ACTOR=
